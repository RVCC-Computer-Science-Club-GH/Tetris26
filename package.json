{
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "esbuild --bundle --sourcemap --format=esm --outdir=public src/index.js src/index.css",
    "build": "esbuild --bundle --minify --format=esm --outdir=public src/index.js src/index.css"
  }
}
