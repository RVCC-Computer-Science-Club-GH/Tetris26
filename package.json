{
  "dependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "esbuild src/index.js --bundle --sourcemap --format=esm --outfile=public/index.js",
    "build": "esbuild src/index.js --bundle --minify --format=esm --outfile=public/index.js"
  }
}
